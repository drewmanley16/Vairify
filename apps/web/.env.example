# Copy to .env.local. No real funds, no private keys here.
# Deployed VairifyEscrow address on the configured chain. Leave empty until deployed.
NEXT_PUBLIC_VAIRIFY_ESCROW_ADDRESS=
# Default: 84532 (Base Sepolia). Use 8453 only with a mainnet deployment.
NEXT_PUBLIC_CHAIN_ID=84532
# Circle USDC on Base Sepolia. Verify at developers.circle.com before mainnet use.
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# WalletConnect Cloud project ID (get one at cloud.walletconnect.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
